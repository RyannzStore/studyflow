# ============================================================
# StudyFlow — contoh environment variable
# Salin menjadi .env.local (lokal) dan isi di Vercel → Settings → Environment Variables
# JANGAN commit file .env.local / secret asli ke Git.
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key (aman di browser, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ⚠️ SERVER-ONLY. Jangan pernah diawali NEXT_PUBLIC_, jangan taruh di frontend.
# Dipakai hanya oleh API route admin (buat akun murid / reset password) & script seed.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Domain email internal untuk login pakai username (username@domain).
# Tidak ada email yang dikirim; cukup konsisten dan jangan diubah setelah akun dibuat.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=studyflow.app
